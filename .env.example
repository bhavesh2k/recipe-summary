# Google Gemini API Key (Get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Cloudflare Turnstile Bot Defense (Free at https://dash.cloudflare.com/?to=/:account/turnstile)
# If omitted, test pass-keys are used and bot protection relies on Origin & Honeypot defense.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
